# Telemach SMS Kurir — the block to paste into /etc/salon.env once the
# contract is signed and the certificate has arrived.
#
#   sudo nano /etc/salon.env        # paste, fill in the four <...> values
#   sudo systemctl restart salon    # required after any change here
#   sudo -u salon SALON_DB=/opt/salon/data/salon.db \
#     node /opt/salon/app/scripts/sms-check.js
#
# Everything below the first block already has a working default. Full guide:
# SETUP.md section 7, "Option D — Telemach SMS Kurir".

# ---------------------------------------------------------------- required

SMS_DRIVER=telemach

# The client certificate Telemach issues at contract signature.
TELEMACH_PFX=/opt/salon/secrets/telemach.p12
TELEMACH_PASSPHRASE=<passphrase-from-telemach>

# ...or, if they issue a PEM pair instead of a .p12, comment out the two lines
# above and use these:
#TELEMACH_CERT=/opt/salon/secrets/telemach.crt
#TELEMACH_KEY=/opt/salon/secrets/telemach.key

# The sender customers will see. Must be registered with Telemach beforehand,
# 3 to 11 characters.
TELEMACH_SENDER=Berni

# Delivery receipts. Give Telemach https://<your-domain>/sms/dlr/<this-value>
# and ask for JSON. Generate with: openssl rand -hex 24
SMS_DLR_SECRET=<paste-openssl-rand-hex-24-output>

# Used to build links in pages and messages.
BASE_URL=https://<your-domain>

# ---------------------------------------------------------------- optional

# 'kurir' in production. While testing, put the test appid Telemach gives you
# here instead — it behaves identically but never delivers to a handset.
#TELEMACH_APPID=kurir

# 0 = send at any hour. Telemach's own default is 1, which refuses to send
# outside 08:00-21:00 and would hold back a reminder for an early appointment.
# Change this only if the salon would rather never message anyone in the evening.
#TELEMACH_SCHEDULE=0

# Hours before an undelivered message is given up on. Worth setting to just
# under the reminder lead time so a reminder can never arrive after the
# appointment it is reminding about.
#TELEMACH_VALIDITY=12

# Only for charged messages. A salon sending its own customers appointment
# notifications has neither.
#TELEMACH_BCODE=
#TELEMACH_BCONTENT=

# ------------------------------------------------------- receipt field names
#
# These are the built-in defaults for this driver. Uncomment only to override.
#
#SMS_DLR_ID_FIELD=SmsStatus.guid
#SMS_DLR_STATUS_FIELD=SmsStatus.deliveryStatus,SmsStatus.sendStatus
#SMS_DLR_DELIVERED=DELIVERED
#SMS_DLR_FAILED=EXPIRED,BLOCKED,SUBSCRIBER_UNKNOWN,ERROR
