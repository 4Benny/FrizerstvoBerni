<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#d10080">
<title><%= title %> · <%= settings.salon_name %></title>
<% if (settings.emblem_url) { %><link rel="icon" href="<%= settings.emblem_url %>"><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/css/public.css?v=<%= assetVersion %>">
</head>
<body>

<div class="page-wrapper">

<header class="booking-head">
  <div class="padding-global"><div class="container-large">
    <div class="booking-head_inner">
      <a class="brand" href="/">
        <% if (settings.logo_url) { %>
          <img src="<%= settings.logo_url %>" alt="<%= settings.salon_name %>" width="494" height="60">
        <% } else { %><%= settings.salon_name %><% } %>
      </a>
      <nav><a class="booking-back" href="/">← Nazaj na spletno stran</a></nav>
    </div>
  </div></div>
</header>

<main class="booking-wrap">
