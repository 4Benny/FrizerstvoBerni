<%- include('partials/head') %>

<p class="crumb"><a href="/app/services">← Storitve</a></p>
<div class="page-head"><h1><%= title %></h1></div>

<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>

<form class="card form" method="post"
      action="<%= service ? '/app/services/' + service.id + '/edit' : '/app/services/new' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="field">
    <label for="name">Ime storitve *</label>
    <input id="name" name="name" type="text" required autofocus value="<%= values.name || '' %>">
  </div>

  <div class="field">
    <label for="description">Skupina ali opis</label>
    <input id="description" name="description" type="text" value="<%= values.description || '' %>"
           placeholder="STRIŽENJE LAS">
    <p class="hint">Na spletni strani se storitve združijo po tem besedilu.</p>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="duration_min">Trajanje (minute) *</label>
      <input id="duration_min" name="duration_min" type="number" min="5" max="720" step="5"
             required inputmode="numeric" value="<%= values.duration_min || 30 %>">
    </div>
    <div class="field">
      <label for="price">Cena (€) *</label>
      <input id="price" name="price" type="text" required inputmode="decimal"
             placeholder="25,00" value="<%= values.price !== undefined ? values.price : '' %>">
      <p class="hint">Vpišite 0, če je cena po dogovoru.</p>
    </div>
    <div class="field">
      <label for="sort_order">Vrstni red</label>
      <input id="sort_order" name="sort_order" type="number" min="0" max="999"
             value="<%= values.sort_order || 0 %>">
    </div>
  </div>

  <label class="check">
    <input type="checkbox" name="active" value="1" <%= values.active ? 'checked' : '' %>>
    Aktivna — prikazana na spletni strani in na voljo pri novih terminih
  </label>

  <div class="form-actions">
    <a class="btn btn-quiet" href="/app/services">Prekliči</a>
    <button type="submit" class="btn btn-primary" data-busy-text="Shranjujem…">Shrani storitev</button>
  </div>
</form>

<%- include('partials/foot') %>
