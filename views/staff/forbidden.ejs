<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · <%= settings.salon_name %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<link rel="stylesheet" href="/css/staff.css?v=<%= assetVersion %>">
</head>
<body class="staff notice-page">
<main class="notice-card">
  <h1><%= title %></h1>
  <p class="notice-sub"><%= typeof message !== 'undefined' && message ? message : 'Te strani ne morete odpreti.' %></p>
  <p class="notice-back">
    <% if (user) { %>
      <a href="/app/calendar">← Nazaj na koledar</a>
    <% } else { %>
      <a href="/login">← Prijava za zaposlene</a>
    <% } %>
  </p>
</main>
</body>
</html>
