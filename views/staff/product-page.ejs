<%- include('partials/head') %>

<p class="crumb"><a href="/app/products">← Izdelki</a></p>

<div class="page-head">
  <h1><%= product.name %><% if (!product.active) { %> <span class="tag tag-muted">IZKLOPLJEN</span><% } %></h1>
  <div class="page-actions">
    <a class="btn" href="/app/products/<%= product.id %>/edit">Uredi izdelek</a>
  </div>
</div>

<div class="cols">
  <section class="card" data-product="<%= product.id %>">
    <h2>Količina</h2>

    <div class="counter counter-big">
      <button type="button" class="btn btn-round" data-stock-delta="-1" data-id="<%= product.id %>"
              aria-label="Zmanjšaj količino">−</button>
      <output class="counter-value" data-stock-value="<%= product.id %>"><%= product.quantity %></output>
      <button type="button" class="btn btn-round btn-primary" data-stock-delta="1" data-id="<%= product.id %>"
              aria-label="Povečaj količino">+</button>
    </div>

    <form method="post" action="/app/products/<%= product.id %>/quantity" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="set">
      <label for="set-qty">Nastavi točno količino</label>
      <input id="set-qty" name="quantity" type="number" min="0" max="999999"
             value="<%= product.quantity %>" inputmode="numeric">
      <button type="submit" class="btn">Shrani količino</button>
    </form>
  </section>

  <section class="card">
    <h2>Podrobnosti</h2>
    <dl class="detail-list">
      <div><dt>Cena</dt><dd><%= util.formatMoney(product.price_cents) %></dd></div>
      <div><dt>Stanje</dt><dd><%= product.active ? 'Aktiven' : 'Izklopljen' %></dd></div>
    </dl>
    <h3>Opis</h3>
    <p class="notes-body"><%= product.description || '—' %></p>
  </section>
</div>

<%- include('partials/foot') %>
