<%- include('partials/head') %>

<div class="page-head"><h1>Nastavitve salona</h1></div>
<p class="page-sub">Spletna stran prevzame vse s te strani. V kodi ni treba spreminjati ničesar.</p>

<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>

<form method="post" action="/app/settings">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card form">
    <h2>Salon</h2>
    <div class="field">
      <label for="salon_name">Ime salona *</label>
      <input id="salon_name" name="salon_name" type="text" required value="<%= values.salon_name %>">
    </div>
    <div class="field">
      <label for="hero_heading">Naslov na vrhu spletne strani</label>
      <input id="hero_heading" name="hero_heading" type="text" value="<%= values.hero_heading %>"
             placeholder="Frizerski salon v Slovenj Gradcu, z vami že od leta 2008.">
      <p class="hint">Velik napis na vrhu. Če je prazno, se izpiše ime salona.</p>
    </div>
    <div class="field">
      <label for="slogan">Kratek slogan</label>
      <input id="slogan" name="slogan" type="text" value="<%= values.slogan %>"
             placeholder="Frizerske storitve">
      <p class="hint">Stavek pod naslovom.</p>
    </div>
    <div class="field">
      <label for="legal_name">Naziv podjetja</label>
      <input id="legal_name" name="legal_name" type="text" value="<%= values.legal_name %>"
             placeholder="Bernarda Hrovat s.p.">
      <p class="hint">Za vrstico z avtorskimi pravicami v nogi. Če je prazno, se izpiše ime salona.</p>
    </div>
    <div class="field">
      <label for="about">Predstavitev</label>
      <textarea id="about" name="about" rows="8"><%= values.about %></textarea>
      <p class="hint">Prazna vrstica loči odstavke.</p>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="logo_url">Logotip</label>
        <input id="logo_url" name="logo_url" type="text" value="<%= values.logo_url %>"
               placeholder="/img/logo.png">
        <p class="hint">Prikaže se namesto imena salona. Če je prazno, se izpiše ime.</p>
      </div>
      <div class="field">
        <label for="emblem_url">Znak</label>
        <input id="emblem_url" name="emblem_url" type="text" value="<%= values.emblem_url %>"
               placeholder="/img/emblem.jpg">
        <p class="hint">Neobvezna okrogla slika na spletni strani.</p>
      </div>
    </div>
    <div class="field">
      <label for="hero_image_url">Velika slika na vrhu strani</label>
      <input id="hero_image_url" name="hero_image_url" type="text" value="<%= values.hero_image_url %>"
             placeholder="/img/salon.jpg">
      <p class="hint">
        Datoteko naložite v mapo <code>public/img/</code> in tukaj vpišite pot, na primer
        <code>/img/salon.jpg</code>. Deluje tudi povezava do slike na spletu. Če je prazno, se
        pokaže znak.
      </p>
    </div>
    <% if (values.logo_url || values.emblem_url || values.hero_image_url) { %>
      <div class="logo-preview">
        <% if (values.logo_url) { %><img src="<%= values.logo_url %>" alt="Predogled logotipa"><% } %>
        <% if (values.emblem_url) { %>
          <img class="is-round" src="<%= values.emblem_url %>" alt="Predogled znaka">
        <% } %>
        <% if (values.hero_image_url) { %>
          <img src="<%= values.hero_image_url %>" alt="Predogled slike na vrhu strani">
        <% } %>
      </div>
    <% } %>
  </section>

  <section class="card form">
    <h2>Poudarki na spletni strani</h2>
    <p class="page-sub">
      Štirje kratki poudarki pod naslovom — na primer naročanje, izkušnje, parkirišče ali
      izdelki, ki jih uporabljate. Poudarek brez naslova se na strani ne pokaže.
    </p>
    <% [1, 2, 3, 4].forEach(function (n) { %>
      <div class="form-row">
        <div class="field">
          <label for="highlight_<%= n %>_title">Naslov <%= n %></label>
          <input id="highlight_<%= n %>_title" name="highlight_<%= n %>_title" type="text"
                 value="<%= values['highlight_' + n + '_title'] %>"
                 placeholder="<%= n === 1 ? 'Brezplačno parkirišče' : '' %>">
        </div>
        <div class="field">
          <label for="highlight_<%= n %>_text">Besedilo <%= n %></label>
          <input id="highlight_<%= n %>_text" name="highlight_<%= n %>_text" type="text"
                 value="<%= values['highlight_' + n + '_text'] %>"
                 placeholder="<%= n === 1 ? 'Salon je v neposredni bližini dvorane Vinka Cajnka.' : '' %>">
        </div>
      </div>
    <% }); %>
  </section>

  <section class="card form">
    <h2>Predstavitev storitev</h2>
    <p class="page-sub">
      Trije predstavitveni bloki nad cenikom. Kartica brez naslova se ne pokaže; če so prazni
      vsi trije, spletna stran sama sestavi kartice iz skupin v ceniku.
    </p>
    <% [1, 2, 3].forEach(function (n) { %>
      <div class="field">
        <label for="service_card_<%= n %>_title">Naslov kartice <%= n %></label>
        <input id="service_card_<%= n %>_title" name="service_card_<%= n %>_title" type="text"
               value="<%= values['service_card_' + n + '_title'] %>"
               placeholder="<%= n === 1 ? 'Striženje las' : '' %>">
      </div>
      <div class="field">
        <label for="service_card_<%= n %>_text">Opis kartice <%= n %></label>
        <textarea id="service_card_<%= n %>_text" name="service_card_<%= n %>_text"
                  rows="2"><%= values['service_card_' + n + '_text'] %></textarea>
      </div>
      <div class="field">
        <label for="service_card_<%= n %>_points">Alineje kartice <%= n %></label>
        <textarea id="service_card_<%= n %>_points" name="service_card_<%= n %>_points"
                  rows="3"><%= values['service_card_' + n + '_points'] %></textarea>
        <p class="hint">Ena alineja na vrstico.</p>
      </div>
      <div class="field">
        <label for="service_card_<%= n %>_image">Slika kartice <%= n %></label>
        <input id="service_card_<%= n %>_image" name="service_card_<%= n %>_image" type="text"
               value="<%= values['service_card_' + n + '_image'] %>"
               placeholder="/img/strizenje.jpg">
        <p class="hint">
          Pot do datoteke v mapi <code>public/img/</code> ali povezava do slike. Če je prazno,
          se pokaže znak v barvi salona.
        </p>
        <% if (values['service_card_' + n + '_image']) { %>
          <div class="logo-preview">
            <img src="<%= values['service_card_' + n + '_image'] %>" alt="Predogled slike kartice <%= n %>">
          </div>
        <% } %>
      </div>
      <% if (n < 3) { %><hr><% } %>
    <% }); %>
  </section>

  <section class="card form">
    <h2>Kontakt</h2>
    <div class="form-row">
      <div class="field">
        <label for="phone">Telefon</label>
        <input id="phone" name="phone" type="tel" value="<%= values.phone %>" placeholder="+386 31 331 636">
      </div>
      <div class="field">
        <label for="email">E-pošta</label>
        <input id="email" name="email" type="email" value="<%= values.email %>">
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="address">Naslov</label>
        <input id="address" name="address" type="text" value="<%= values.address %>">
      </div>
      <div class="field">
        <label for="city">Kraj</label>
        <input id="city" name="city" type="text" value="<%= values.city %>">
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="instagram">Povezava Instagram</label>
        <input id="instagram" name="instagram" type="url" value="<%= values.instagram %>"
               placeholder="https://instagram.com/…">
      </div>
      <div class="field">
        <label for="facebook">Povezava Facebook</label>
        <input id="facebook" name="facebook" type="url" value="<%= values.facebook %>"
               placeholder="https://facebook.com/…">
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="other_link_label">Naziv druge povezave</label>
        <input id="other_link_label" name="other_link_label" type="text"
               value="<%= values.other_link_label %>" placeholder="TikTok">
      </div>
      <div class="field">
        <label for="other_link">Druga povezava</label>
        <input id="other_link" name="other_link" type="url" value="<%= values.other_link %>">
      </div>
    </div>
    <div class="field">
      <label for="map_url">Povezava do zemljevida</label>
      <input id="map_url" name="map_url" type="url" value="<%= values.map_url %>"
             placeholder="https://maps.google.com/…">
    </div>
  </section>

  <section class="card form">
    <h2>Delovni čas</h2>
    <p class="hint">
      Prikaže se na spletni strani in določa, katere ure koledar poudari.
      Za dan brez stalnega časa izberite <strong>Po dogovoru</strong> in vpišite svoje besedilo.
    </p>

    <div class="hours-editor">
      <% hours.forEach(function (day) { %>
        <div class="hours-day" data-hours-day>
          <div class="hours-name"><%= day.name %></div>

          <div class="hours-mode">
            <label class="radio">
              <input type="radio" name="mode_<%= day.day %>" value="open" data-hours-mode
                     <%= day.mode === 'open' ? 'checked' : '' %>>
              Odprto
            </label>
            <label class="radio">
              <input type="radio" name="mode_<%= day.day %>" value="text" data-hours-mode
                     <%= day.mode === 'text' ? 'checked' : '' %>>
              Po dogovoru
            </label>
            <label class="radio">
              <input type="radio" name="mode_<%= day.day %>" value="closed" data-hours-mode
                     <%= day.mode === 'closed' ? 'checked' : '' %>>
              Zaprto
            </label>
          </div>

          <div class="hours-inputs">
            <span class="hours-times" data-hours-times <%= day.mode === 'open' ? '' : 'hidden' %>>
              <input type="time" name="open_<%= day.day %>"
                     value="<%= day.open || '08:00' %>"
                     aria-label="<%= day.name %> — odprtje">
              <span aria-hidden="true">–</span>
              <input type="time" name="close_<%= day.day %>"
                     value="<%= day.close || '18:00' %>"
                     aria-label="<%= day.name %> — zaprtje">
            </span>
            <input class="hours-text" type="text" name="text_<%= day.day %>"
                   value="<%= day.text %>" maxlength="60"
                   placeholder="Po dogovoru"
                   aria-label="<%= day.name %> — besedilo"
                   data-hours-text <%= day.mode === 'text' ? '' : 'hidden' %>>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <section class="card form">
    <h2>Koledar</h2>
    <div class="form-row">
      <div class="field">
        <label for="calendar_start">Začetek koledarja</label>
        <input id="calendar_start" name="calendar_start" type="time" required
               value="<%= values.calendar_start %>">
      </div>
      <div class="field">
        <label for="calendar_end">Konec koledarja</label>
        <input id="calendar_end" name="calendar_end" type="time" required
               value="<%= values.calendar_end %>">
      </div>
    </div>
    <p class="hint">
      Termin zunaj tega časa je še vedno viden — koledar se razširi, da ga prikaže.
    </p>
  </section>

  <section class="card form">
    <h2>Zvestoba</h2>
    <div class="field">
      <label for="paid_before_free">Število plačanih striženj do brezplačnega</label>
      <input id="paid_before_free" name="paid_before_free" type="number" min="1" max="99"
             required inputmode="numeric" value="<%= values.paid_before_free %>">
      <p class="hint">
        Pri vrednosti <strong><%= values.paid_before_free %></strong> stranka plača
        <%= values.paid_before_free %> striženj, naslednje pa je brezplačno.
      </p>
    </div>
  </section>

  <section class="card form">
    <h2>Spletno naročanje</h2>
    <label class="check">
      <input type="checkbox" name="public_booking_enabled" value="1"
             <%= values.public_booking_enabled === '1' ? 'checked' : '' %>>
      Stranke se lahko naročijo same prek spletne strani
    </label>
    <p class="hint">
      Stranka izbere storitev, frizerko in prosto uro, nato pa številko potrdi
      s kodo po SMS — brez tega bi lahko kdorkoli napolnil koledar z izmišljenimi
      imeni. <strong>Deluje samo, kadar je SMS vklopljen in nastavljen na pravi
      prehod.</strong> Ponujene so le ure znotraj urnika posamezne frizerke, v
      katere izbrana storitev v celoti sodi.
    </p>
    <% if (values.public_booking_enabled === '1' && values.sms_enabled !== '1') { %>
      <p class="hint hint-warn">
        Spletno naročanje je vklopljeno, a SMS ni — dokler ga ne vklopite,
        stranke ne morejo potrditi številke in naročanje ni na voljo.
      </p>
    <% } %>
  </section>

  <section class="card form">
    <h2>SMS obvestila</h2>
    <label class="check">
      <input type="checkbox" name="sms_enabled" value="1" <%= values.sms_enabled === '1' ? 'checked' : '' %>>
      Pošlji SMS ob naročilu, prestavitvi in odpovedi
    </label>
    <label class="check">
      <input type="checkbox" name="sms_plain_text" value="1"
             <%= values.sms_plain_text === '1' ? 'checked' : '' %>>
      Pošiljaj brez šumnikov (priporočeno)
    </label>
    <p class="hint">
      En sam <strong>š</strong>, <strong>č</strong> ali <strong>ž</strong> potisne
      sporočilo v Unicode, kjer je meja namesto 160 znakov le <strong>70</strong> —
      potrditev termina se tako zaračuna kot <strong>dve</strong> sporočili namesto
      enega. Brez šumnikov se glasi „Pozdravljeni Ana, naroceni ste …" in stane
      polovico.
    </p>

    <label class="check">
      <input type="checkbox" name="sms_reminder_enabled" value="1"
             <%= values.sms_reminder_enabled === '1' ? 'checked' : '' %>>
      Pošlji opomnik pred terminom
    </label>
    <div class="field field-narrow">
      <label for="sms_reminder_hours_before">Opomnik koliko ur pred terminom</label>
      <input id="sms_reminder_hours_before" name="sms_reminder_hours_before"
             type="number" min="1" max="168" step="1"
             value="<%= values.sms_reminder_hours_before %>">
      <p class="hint">
        Vsaka stranka prejme največ en opomnik na termin. Če je bil termin
        naročen znotraj tega okna, opomnika ne pošljemo — stranka je pravkar
        prejela potrditev.
      </p>
    </div>

    <p class="hint">
      Aktivni prehod: <strong><%= smsDriver %></strong>.
      <% if (smsDriver === 'log') { %>
        Sporočila se zapišejo v dnevnik strežnika in shranijo v sistem, da lahko salon
        preveri celoten potek. Za pošiljanje pravih sporočil nastavite
        <code>SMS_DRIVER</code> in okoljske spremenljivke ponudnika.
      <% } %>
      Potek pošiljanja je viden v <a href="/app/sms">SMS dnevniku</a>.
    </p>
  </section>

  <div class="form-actions form-actions-sticky">
    <button type="submit" class="btn btn-primary" data-busy-text="Shranjujem…">Shrani nastavitve</button>
  </div>
</form>

<%- include('partials/foot') %>
